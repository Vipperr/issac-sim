  <joint name="Joint_ee_1" type="prismatic">
    <parent link="Link_6"/>
    <child link="ee_1"/>
    <origin xyz="-0.085 -0.00420001 0.0858" rpy="-1.57079633 0 -1.57079633"/>
    <axis xyz="0 0 -1"/>
    <!--
      0 = 完全闭合，0.05 = 齿条行程上限。行程是单向的，所以下限是 0 而不是
      -0.05。齿轮半径 1cm，所以 0.05m 对应夹爪电机转 5rad。
    -->
    <limit lower="0" upper="0.05" effort="100" velocity="0.1"/>
  </joint>
