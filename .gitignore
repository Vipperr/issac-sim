.git-metadata/

# Generated experiment artifacts; keep source and reproducible scripts in Git.
peg_insert_reproduction/archive/
__pycache__/
*.py[cod]

# Large experiment artifacts, kept in the cloud backup instead of Git.
# cloud_sync/ holds 204 MB checkpoints, above GitHub's 100 MB per-file limit.
peg_insert_reproduction/cloud_sync/
peg_insert_reproduction/videos/
peg_insert_reproduction/eval_results/
peg_insert_reproduction/logs/
peg_insert_reproduction/training_logs/

# The USD assets stay tracked: rebot_assets/ holds the UrdfConverter output
# (converted on a remote host) and factory_collision_sources/ holds the SDF
# surfaces that export_factory_collision.py consumes. Both are inputs this
# repository cannot regenerate without the cloud machine.

